#!/bin/sh
# Runs before every commit. Blocks the commit if anything fails.
#
# Deliberately fast: the test suite and the build check, about two seconds.
# Parity and measurement run in pre-push instead, since they are slower and
# only matter at the point work leaves this machine.

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 1

# Use the first interpreter that actually runs. On Windows, `python3` is often
# the Microsoft Store placeholder or a second install without this project's
# dependencies, while `python` is the one the reader uses, so try it first.
PY=
for c in python python3 py; do
  if command -v $c >/dev/null 2>&1 && $c -c "import sys" >/dev/null 2>&1; then PY=$c; break; fi
done
# Python on Windows prints to a pipe in cp1252 unless told otherwise, and the
# tests print non-Latin text.
export PYTHONIOENCODING=utf-8 PYTHONUTF8=1
[ -n "$PY" ] || { echo "pre-commit: no python found, skipping checks"; exit 0; }

fail=0

printf 'pre-commit: tests ....... '
if out=$($PY tests/test_corpusprep.py 2>&1); then
  printf '%s\n' "$(printf '%s' "$out" | grep 'passed,' | tr -s ' ')"
else
  printf 'FAILED\n'
  if printf '%s\n' "$out" | grep -qE '^  FAIL'; then
    printf '%s\n' "$out" | grep -E '^  FAIL' | head -10
  else
    # No failing test was reported, so the suite stopped before it could
    # report one. Show the end of what it printed, which names the cause.
    echo "  the test script stopped early, using $PY. Last lines:"
    printf '%s\n' "$out" | tail -8 | sed 's/^/    /'
  fi
  fail=1
fi

printf 'pre-commit: build ....... '
if $PY build/build.py --check >/dev/null 2>&1; then
  printf 'docs/index.html matches its sources\n'
else
  printf 'FAILED\n'
  echo '  docs/index.html does not match build/. Run: python build/build.py'
  fail=1
fi

if [ $fail -ne 0 ]; then
  echo
  echo 'Commit refused. Fix the above, or use --no-verify to commit anyway.'
  exit 1
fi
exit 0
